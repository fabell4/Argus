# ==============================================================================
# Application
# ==============================================================================
APP_ENV=development
LOG_LEVEL=INFO
TZ=UTC

# ==============================================================================
# Polling
# ==============================================================================
POLL_INTERVAL_MINUTES=5
POLL_ON_STARTUP=true

# ==============================================================================
# NUT (Network UPS Tools)
# ==============================================================================
# In Docker, localhost means the Argus container itself — not the host machine.
# If NUT is installed directly on the host (most common), use:
#   NUT_HOST=host.docker.internal
# The compose file already maps host.docker.internal → host gateway on Linux.
# If NUT runs as another Docker service, use its container/service name instead.
NUT_HOST=host.docker.internal
NUT_PORT=3493
NUT_USERNAME=
NUT_PASSWORD=
# Single UPS name, or comma-separated list when auto-discover is disabled.
NUT_UPS_NAME=ups
# Set to true to query LIST UPS and poll all devices; false to use NUT_UPS_NAME.
NUT_AUTO_DISCOVER=true

# ==============================================================================
# SNMP
# ==============================================================================
SNMP_COMMUNITY=public
SNMP_VERSION=2c
SNMP_TIMEOUT=5
SNMP_RETRIES=2

# ==============================================================================
# SNMPv3 (optional — leave blank to use community-string auth above)
# ==============================================================================
SNMP_V3_USERNAME=
SNMP_V3_AUTH_PROTOCOL=MD5
SNMP_V3_AUTH_KEY=
SNMP_V3_PRIV_PROTOCOL=DES
SNMP_V3_PRIV_KEY=

# ==============================================================================
# Exporters (comma-separated)
# sqlite | prometheus | influxdb | loki | csv | energy
# ==============================================================================
ENABLED_EXPORTERS=sqlite

# ==============================================================================
# SQLite
# ==============================================================================
SQLITE_PATH=data/argus.db
SQLITE_RETENTION_DAYS=90
SQLITE_MAX_ROWS=100000

# ==============================================================================
# Prometheus
# ==============================================================================
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=9090
# Set to true to disable device_id/device_type labels (prevents cardinality explosion
# with large numbers of devices)
PROMETHEUS_DISABLE_LABELS=false

# ==============================================================================
# InfluxDB v2
# ==============================================================================
# To export to InfluxDB, add influxdb to ENABLED_EXPORTERS and set INFLUXDB_URL,
# INFLUXDB_TOKEN, and INFLUXDB_ORG. The DOCKER_INFLUXDB_INIT_* values only
# initialize the optional InfluxDB container.
INFLUXDB_ENABLED=false
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ORG=
INFLUXDB_BUCKET=argus
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=
DOCKER_INFLUXDB_INIT_PASSWORD=

# ==============================================================================
# CSV exporter
# ==============================================================================
CSV_PATH=data/argus.csv
CSV_MAX_SIZE_MB=10
CSV_RETENTION_DAYS=30

# ==============================================================================
# Energy accumulation
# ==============================================================================
# Cost per kWh in your local currency (0 = disable cost estimation)
ENERGY_RATE_PER_KWH=0

# ==============================================================================
# Event thresholds
# ==============================================================================
# Number of consecutive missed polls before a device is marked offline
DEVICE_OFFLINE_MISSED_POLLS=3
# Battery % at which SHUTDOWN_INITIATED fires (device must also be on battery)
SHUTDOWN_BATTERY_FLOOR_PCT=5
# Load % above which THRESHOLD_CROSSED fires
THRESHOLD_LOAD_PERCENT=90
# Temperature (°C) above which THRESHOLD_CROSSED fires
THRESHOLD_TEMP_CELSIUS=50

# ==============================================================================
# API
# ==============================================================================
API_HOST=0.0.0.0
API_PORT=8000
# Minimum 32 characters. Leave empty to disable authentication.
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

# ==============================================================================
# Alerting
# ==============================================================================
ALERT_FAILURE_THRESHOLD=3
ALERT_COOLDOWN_SECONDS=3600

# Webhook
WEBHOOK_URL=

# Gotify
GOTIFY_URL=
GOTIFY_TOKEN=
GOTIFY_PRIORITY=

# ntfy
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=
NTFY_TAGS=

# Apprise
APPRISE_URL=

# ==============================================================================
# Health server
# ==============================================================================
HEALTH_PORT=9100
