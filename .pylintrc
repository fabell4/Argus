[BASIC]
# Allow UPPER_CASE constants, __dunder__ names, and _lower_case private
# module-level state variables (e.g. _scheduler, _alert_manager).
const-rgx=(([A-Z_][A-Z0-9_]*)|(__.*__)|(_[a-z][a-z_0-9]*))$

[MESSAGES CONTROL]
# W0212 protected-access: ruff SLF001 is the primary enforcement; test files
#   legitimately access private members for white-box testing.
# W0111 assignment-from-none: false positive when optional deps (pysnmp, influxdb)
#   are not installed — pylint can't resolve the conditional import code path.
# W0231 super-init-not-called: intentional in test handler stubs that avoid binding
#   real sockets.
disable=
    W0212,
    W0111,
    W0231
