{
  "poll_interval_minutes": 10,
  "enabled_exporters": [
    "sqlite"
  ],
  "scanning_disabled": false,
  "scheduler_paused": false,
  "next_poll_at": null,
  "last_poll_at": null,
  "alert_config": {
    "providers": [
      {
        "type": "webhook",
        "enabled": true,
        "url": "https://hooks.example.com/argus",
