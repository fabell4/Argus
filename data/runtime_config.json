  "nut_username": "",
  "nut_password": "",
  "nut_ups_name": "ups",
  "nut_auto_discover": true,
  "device_offline_missed_polls": 3,
  "shutdown_battery_floor_pct": 5.0,
  "threshold_load_percent": 90.0,
  "threshold_temp_celsius": 50.0
